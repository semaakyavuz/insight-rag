{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(pip install *)",
      "Bash(alembic *)",
      "Bash(python *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(curl *)",
      "Bash(taskkill *)",
      "Bash(netstat *)",
      "Bash(break)",
      "WebSearch",
      "WebFetch",
      "Bash(python -c \"import groq; print\\(groq.__version__\\)\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/semaa/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/semaa/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}
